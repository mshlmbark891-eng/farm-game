
config_version=5

[application]
config/name="FarmLifeAR"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.2", "GL Compatibility")
config/description="FarmLifeAR - Arabic mobile farming and business simulation"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=960
window/size/window_height_override=540
window/stretch/mode="canvas_items"

[input]
move_up={
"deadzone": 0.2,
"events": [Object(InputEventKey, "physical_keycode": 87)]
}
move_down={
"deadzone": 0.2,
"events": [Object(InputEventKey, "physical_keycode": 83)]
}
move_left={
"deadzone": 0.2,
"events": [Object(InputEventKey, "physical_keycode": 65)]
}
move_right={
"deadzone": 0.2,
"events": [Object(InputEventKey, "physical_keycode": 68)]
}
interact={
"deadzone": 0.2,
"events": [Object(InputEventKey, "physical_keycode": 69)]
}

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.18, 0.31, 0.19, 1)
textures/default_filters/use_nearest_mipmap_filter=false
